<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_controller"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_controller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_home_controller"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_home"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTROLLER"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="?attr/mainFontFamily"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_settings_controller"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connected to Lorem Ipsum"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:background="@color/accent"
        android:gravity="center"
        android:paddingVertical="24dp"
        android:fontFamily="?attr/mainFontFamily"
        app:layout_constraintTop_toBottomOf="@id/header_controller" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/status_bar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_left_click"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:text="Left Click"
                android:textSize="24sp"
                android:textColor="@color/black"
                android:textAllCaps="false"
                android:backgroundTint="@color/accent"
                app:cornerRadius="16dp"
                android:layout_marginTop="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_right_click"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="100dp"
                    android:text="Right Click"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/primary"
                    app:cornerRadius="16dp"
                    android:layout_marginEnd="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_double_click"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="100dp"
                    android:text="Double Click"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/primary"
                    app:cornerRadius="16dp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scroll_up"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="100dp"
                    android:text="Scroll Up"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/primary"
                    app:cornerRadius="16dp"
                    android:layout_marginEnd="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scroll_down"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="100dp"
                    android:text="Scroll Down"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/primary"
                    app:cornerRadius="16dp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Drag Container -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F0F5FA"
                android:layout_marginTop="24dp"
                android:padding="16dp">

                <TextView
                    android:id="@+id/label_drag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Drag"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <GridLayout
                    android:id="@+id/drag_grid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="3"
                    app:layout_constraintStart_toEndOf="@id/label_drag"
                    app:layout_constraintEnd_toStartOf="@id/label_tap_grab"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <Space android:layout_width="70dp" android:layout_height="70dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_drag_up"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:padding="0dp"
                        android:text="Drag\nUp"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:backgroundTint="@color/accent"
                        app:cornerRadius="12dp"
                        android:layout_margin="4dp"/>
                    <Space android:layout_width="70dp" android:layout_height="70dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_drag_left"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:padding="0dp"
                        android:text="Drag\nLeft"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:backgroundTint="@color/accent"
                        app:cornerRadius="12dp"
                        android:layout_margin="4dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_grab"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:padding="0dp"
                        android:text="Grab"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:backgroundTint="@color/accent"
                        app:cornerRadius="12dp"
                        android:layout_margin="4dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_drag_right"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:padding="0dp"
                        android:text="Drag\nRight"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:backgroundTint="@color/accent"
                        app:cornerRadius="12dp"
                        android:layout_margin="4dp"/>

                    <Space android:layout_width="70dp" android:layout_height="70dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_drag_down"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:padding="0dp"
                        android:text="Drag\nDown"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:backgroundTint="@color/accent"
                        app:cornerRadius="12dp"
                        android:layout_margin="4dp"/>
                    <Space android:layout_width="70dp" android:layout_height="70dp" />

                </GridLayout>

                <TextView
                    android:id="@+id/label_tap_grab"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Tap grab to start"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
